# Desenvolvimento local. Não usar dados de pacientes nesta versão.
PORT=3333
# MongoDB Atlas: preencher apenas no ambiente privado/Render.
# MONGODB_URI=mongodb+srv://USUARIO:SENHA@HOST/artisti?retryWrites=true&w=majority&authSource=admin
MONGODB_DB=artisti
# Não configure DATABASE_URL junto com MONGODB_URI.
# Ausente: PostgreSQL embarcado persistente em backend/.data/postgres.
# DATABASE_URL=postgresql://user:password@localhost:5432/artisti_dev
# Integração opcional. Sem valores reais e desligada por padrão.
WHATSAPP_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
# O Instagram Direct é um conector independente do WhatsApp.
INSTAGRAM_ENABLED=false
META_GRAPH_VERSION=v26.0
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USERNAME=
# O Messenger usa a Página do Facebook e o mesmo App Secret do aplicativo Meta.
MESSENGER_ENABLED=false
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
# Marketing API será habilitada separadamente; o token do Instagram não lê anúncios.
META_MARKETING_ENABLED=false
META_MARKETING_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_AD_TIMEZONE=America/Sao_Paulo
# PWA funciona sem push. Gerar o par localmente: npm run push:keys -w backend
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Access token é usado no painel/Graph API para configurar a assinatura da WABA.
# O receptor de webhooks não precisa desse token: valida HMAC com APP_SECRET.
# As variáveis são lidas do processo; este arquivo não é carregado automaticamente.
# Render: configurar pela interface, nunca versionar valores reais.
# NODE_ENV=production
# BOOTSTRAP_ADMIN_LOGIN=master
# BOOTSTRAP_ADMIN_PASSWORD=<senha>
# Redefinição pontual: MASTER_LOGIN e MASTER_PASSWORD + npm run master:reset -w backend
# APP_ORIGIN=https://seu-dominio.example.com

# Checagem documental: desligada até configurar e homologar com documentos autorizados.
# Não preencher chaves neste arquivo versionado. Use as variáveis privadas do servidor.
COMMERCIAL_EVIDENCE_ENABLED=false
COMMERCIAL_AI_ENABLED=false
COMMERCIAL_AI_AUTO_VALIDATE=false
GEMINI_API_KEY=
# Identificador exato do modelo de visão disponível na conta; sem fallback de provedor.
COMMERCIAL_AI_MODEL=
# CNPJ/CPF/chaves PIX autorizadas da clínica, separados por vírgula (identificadores exatos).
COMMERCIAL_PAYMENT_RECIPIENTS=
# Limite diário de chamadas, incluindo novas tentativas; fuso America/Sao_Paulo.
COMMERCIAL_AI_DAILY_LIMIT=100
# true: worker embutido na API. false: usar npm run commercial:worker -w backend em processo separado.
COMMERCIAL_WORKER_ENABLED=true
