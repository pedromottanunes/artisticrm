# Desenvolvimento local. Não usar dados de pacientes nesta versão.
PORT=3333
# MongoDB Atlas: preencher apenas no ambiente privado/Render.
# MONGODB_URI=mongodb+srv://USUARIO:SENHA@HOST/artisti?retryWrites=true&w=majority&authSource=admin
MONGODB_DB=artisti
# Não configure DATABASE_URL junto com MONGODB_URI.
# Ausente: PostgreSQL embarcado persistente em backend/.data/postgres.
# DATABASE_URL=postgresql://user:password@localhost:5432/artisti_dev
# Integração opcional. Sem valores reais e desligada por padrão.
WHATSAPP_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
# PWA funciona sem push. Gerar o par localmente: npm run push:keys -w backend
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Access token é usado no painel/Graph API para configurar a assinatura da WABA.
# O receptor de webhooks não precisa desse token: valida HMAC com APP_SECRET.
# As variáveis são lidas do processo; este arquivo não é carregado automaticamente.
# Render: configurar pela interface, nunca versionar valores reais.
# NODE_ENV=production
# BOOTSTRAP_ADMIN_EMAIL=gestor@example.com
# BOOTSTRAP_ADMIN_PASSWORD=<senha-exclusiva-6-caracteres-ou-mais>
# APP_ORIGIN=https://seu-dominio.example.com
